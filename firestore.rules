rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == 'picbazer@gmail.com');
      allow delete: if isAuthenticated() && request.auth.token.email == 'picbazer@gmail.com';
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isAuthenticated() || true; // allow demo submissions
      allow update, delete: if true; // allow demo moderation
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Favorites collection
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }
  }
}
